---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Badge from "../components/Badge.astro";
import BlogCard from "../components/BlogCard.astro";
import authorAvatar from "../assets/foto.jpg";

type Props = CollectionEntry<"blog">["data"] & {
  readingTime?: number;
  relatedPosts?: CollectionEntry<"blog">[];
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  readingTime,
  relatedPosts = [],
} = Astro.props;

const shareUrl = encodeURIComponent(Astro.url.href);
const shareTitle = encodeURIComponent(title);
---

<BaseLayout
  pageTitle={title}
  description={description}
  image={heroImage}
  mainClass="has-sections"
  hideTitle={true}
>
  <section class="border-t-0 pt-10 pb-16">
    <div class="w-full max-w-240 lg:max-w-6xl mx-auto px-4 md:px-8">
      <article class="w-full">
        <header class="mb-8">
          <a
            href="/blog/"
            class="inline-flex items-center gap-1.5 text-brand text-[0.9375rem] font-semibold no-underline mb-6 transition-all duration-150 hover:text-brand-hover hover:-translate-x-0.75"
          >
            &larr; Volver al blog
          </a>

          {tags && tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-4">
              {tags.map((tag) => (
                <a href={`/blog/tags/${tag}/`} class="no-underline">
                  <Badge text={tag} />
                </a>
              ))}
            </div>
          )}

          <h1 class="text-[clamp(1.85rem,4vw,2.75rem)] leading-[1.2] m-0 mb-4 text-text font-bold">
            {title}
          </h1>

          <div class="flex flex-wrap items-center gap-2 text-sm text-text-muted">
            <FormattedDate date={pubDate} />
            {readingTime && (
              <>
                <span class="opacity-60" aria-hidden="true">
                  ·
                </span>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-surface border border-border text-[0.8125rem] font-medium text-text">
                  {readingTime} min de lectura
                </span>
              </>
            )}
            {updatedDate && (
              <>
                <span class="opacity-60" aria-hidden="true">
                  ·
                </span>
                <span class="italic">
                  Actualizado el <FormattedDate date={updatedDate} />
                </span>
              </>
            )}
          </div>
        </header>

        {heroImage && (
          <div class="w-full mb-10">
            <Image
              width={1020}
              height={512}
              src={heroImage}
              alt={title}
              class="block w-full h-auto max-h-112 object-cover rounded-xl shadow-[0_8px_24px_var(--color-shadow-brand)] border border-border"
              loading="eager"
            />
          </div>
        )}

        {/* Contenido Markdown con tipografía 100% Tailwind */}
        <div class="w-full max-w-195 mx-auto text-text leading-relaxed [&_h2]:text-[1.75rem] [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:text-text [&_h2]:border-b [&_h2]:border-border [&_h2]:pb-2 [&_h3]:text-[1.35rem] [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:text-text [&_p]:mb-5 [&_p]:max-w-full [&_ul]:mb-5 [&_ul]:pl-6 [&_ol]:mb-5 [&_ol]:pl-6 [&_li]:mb-2 [&_blockquote]:my-6 [&_blockquote]:py-4 [&_blockquote]:px-5 [&_blockquote]:border-l-4 [&_blockquote]:border-brand [&_blockquote]:bg-surface [&_blockquote]:rounded-r-lg [&_blockquote]:italic [&_blockquote]:text-text-muted [&_pre]:py-4 [&_pre]:px-5 [&_pre]:rounded-lg [&_pre]:my-6 [&_pre]:overflow-x-auto [&_pre]:border [&_pre]:border-border [&_:not(pre)>code]:py-0.5 [&_:not(pre)>code]:px-1.5 [&_:not(pre)>code]:text-[0.875em] [&_:not(pre)>code]:bg-surface-muted [&_:not(pre)>code]:rounded [&_:not(pre)>code]:text-brand [&_table]:w-full [&_table]:border-collapse [&_table]:my-6 [&_table]:text-[0.95rem] [&_th]:py-3 [&_th]:px-4 [&_th]:border [&_th]:border-border [&_th]:bg-surface-muted [&_th]:font-semibold [&_th]:text-text [&_th]:text-left [&_td]:py-3 [&_td]:px-4 [&_td]:border [&_td]:border-border [&_td]:text-left [&_img]:max-w-full [&_img]:h-auto [&_img]:rounded-lg [&_img]:my-6 [&_a]:text-brand [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-brand-hover">
          <slot />
        </div>

        <footer class="w-full max-w-195 mx-auto mt-14 pt-8 border-t border-border flex flex-col gap-8">
          <div class="flex items-start gap-4">
            <Image
              src={authorAvatar}
              alt="Wilmer Gulcochía"
              width={44}
              height={44}
              densities={[1, 2]}
              class="w-11 h-11 shrink-0 rounded-full object-cover"
              loading="lazy"
            />
            <div>
              <p class="m-0 mb-1 font-bold text-[0.9375rem] text-text">
                Wilmer Gulcochía
              </p>
              <p class="m-0 text-[0.8125rem] leading-normal text-text-muted max-w-[38ch]">
                Desarrollador web fullstack con IA, enfocado en Astro,
                TypeScript y rendimiento web.
              </p>
            </div>
          </div>

          <div>
            <p class="m-0 mb-3 text-sm font-bold text-text">
              Comparte este artículo
            </p>
            <div class="flex flex-wrap gap-2.5">
              <a
                href={`https://twitter.com/intent/tweet?text=${shareTitle}&url=${shareUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 py-2 px-3.5 rounded-lg bg-brand text-text-inverse text-sm font-semibold no-underline transition-all duration-150 hover:bg-brand-hover hover:-translate-y-px"
              >
                <span
                  class="inline-block w-4 h-4 shrink-0 bg-current [mask:var(--icon)_no-repeat_center/contain] [-webkit-mask:var(--icon)_no-repeat_center/contain]"
                  style="--icon: url('/icons/social/x.svg')"
                  aria-hidden="true"
                ></span>
                X / Twitter
              </a>

              <a
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 py-2 px-3.5 rounded-lg bg-brand text-text-inverse text-sm font-semibold no-underline transition-all duration-150 hover:bg-brand-hover hover:-translate-y-px"
              >
                <span
                  class="inline-block w-4 h-4 shrink-0 bg-current [mask:var(--icon)_no-repeat_center/contain] [-webkit-mask:var(--icon)_no-repeat_center/contain]"
                  style="--icon: url('/icons/social/linkedin.svg')"
                  aria-hidden="true"
                ></span>
                LinkedIn
              </a>

              <a
                href={`https://news.ycombinator.com/submitlink?u=${shareUrl}&t=${shareTitle}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 py-2 px-3.5 rounded-lg bg-brand text-text-inverse text-sm font-semibold no-underline transition-all duration-150 hover:bg-brand-hover hover:-translate-y-px"
              >
                <span
                  class="inline-block w-4 h-4 shrink-0 bg-current [mask:var(--icon)_no-repeat_center/contain] [-webkit-mask:var(--icon)_no-repeat_center/contain]"
                  style="--icon: url('/icons/social/hackernews.svg')"
                  aria-hidden="true"
                ></span>
                Hacker News
              </a>

              <a
                href={`https://www.reddit.com/submit?url=${shareUrl}&title=${shareTitle}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 py-2 px-3.5 rounded-lg bg-brand text-text-inverse text-sm font-semibold no-underline transition-all duration-150 hover:bg-brand-hover hover:-translate-y-px"
              >
                <span
                  class="inline-block w-4 h-4 shrink-0 bg-current [mask:var(--icon)_no-repeat_center/contain] [-webkit-mask:var(--icon)_no-repeat_center/contain]"
                  style="--icon: url('/icons/social/reddit.svg')"
                  aria-hidden="true"
                ></span>
                Reddit
              </a>

              <a
                href={`https://wa.me/?text=${shareTitle}%20${shareUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 py-2 px-3.5 rounded-lg bg-brand text-text-inverse text-sm font-semibold no-underline transition-all duration-150 hover:bg-brand-hover hover:-translate-y-px"
              >
                <span
                  class="inline-block w-4 h-4 shrink-0 bg-current [mask:var(--icon)_no-repeat_center/contain] [-webkit-mask:var(--icon)_no-repeat_center/contain]"
                  style="--icon: url('/icons/social/whatsapp.svg')"
                  aria-hidden="true"
                ></span>
                WhatsApp
              </a>
            </div>
          </div>
        </footer>
      </article>
    </div>
  </section>

  {relatedPosts.length > 0 && (
    <section class="border-t-0 pt-10 pb-16" aria-labelledby="related-heading">
      <div class="w-full max-w-240 lg:max-w-6xl mx-auto px-4 md:px-8">
        <h2 id="related-heading" class="text-2xl font-bold m-0 mb-6 text-text">
          Artículos que te pueden gustar
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedPosts.map((related) => (
            <BlogCard post={related} />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
