---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Badge from "../components/Badge.astro";

type Props = CollectionEntry<"blog">["data"] & {
  readingTime?: number;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  readingTime,
} = Astro.props;
---

<BaseLayout
  pageTitle={title}
  description={description}
  eyebrow="BLOG"
  hideTitle={true}
>
  <article class="blog-post">
    {
      heroImage && (
        <div class="hero-image">
          <Image width={1020} height={512} src={heroImage} alt={title} />
        </div>
      )
    }
    <div class="prose">
      <header class="post-header">
        <div class="post-meta">
          <FormattedDate date={pubDate} />
          {
            readingTime && (
              <span class="reading-time">. {readingTime} min de lectura</span>
            )
          }
          {
            updatedDate && (
              <span class="last-updated-on">
                . (Actualizado el <FormattedDate date={updatedDate} />)
              </span>
            )
          }
        </div>
        <h1 class="post-title">{title}</h1>
        {
          tags && tags.length > 0 && (
            <div class="post-tags">
              {tags.map((tag) => (
                <a href={`/blog/tags/${tag}/`} class="tag-link">
                  <Badge text={`#${tag}`} />
                </a>
              ))}
            </div>
          )
        }
        <hr class="post-divider" />
      </header>
      <div class="post-content">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .blog-post {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
  }

  .hero-image {
    width: 100%;
    margin-bottom: 2rem;
  }

  .hero-image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: var(--shadow-md, 0 4px 6px -1px rgba(0, 0, 0, 0.1));
    border: 1px solid var(--color-border-subtle, rgba(0, 0, 0, 0.08));
  }

  .prose {
    color: var(--color-text-main, #1e293b);
    line-height: 1.75;
  }

  .post-header {
    margin-bottom: 2.5rem;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted, #64748b);
    margin-bottom: 0.75rem;
  }

  .last-updated-on {
    font-style: italic;
  }
  .post-title {
    font-size: 2.25rem;
    line-height: 1.25;
    margin: 0 0 1rem 0;
    color: var(--color-text-main, #0f172a);
    font-weight: 700;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .tag-link {
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .tag-link:hover {
    transform: translateY(-1px);
  }
  .post-divider {
    border: 0;
    border-top: 1px solid var(--color-border-subtle, rgba(0, 0, 0, 0.1));
    margin: 1.5rem 0 2rem 0;
  }
  /* Estilos de tipografía y contenido de Markdown (.post-content) */
  .post-content :global(h2) {
    font-size: 1.75rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-text-main, #0f172a);
    border-bottom: 1px solid var(--color-border-subtle, rgba(0, 0, 0, 0.06));
    padding-bottom: 0.5rem;
  }
  .post-content :global(h3) {
    font-size: 1.35rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--color-text-main, #0f172a);
  }
  .post-content :global(p) {
    margin-bottom: 1.25rem;
  }
  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }
  .post-content :global(blockquote) {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border-left: 4px solid var(--color-accent, #3b82f6);
    background-color: var(--color-surface, rgba(0, 0, 0, 0.02));
    border-radius: 0 8px 8px 0;
    font-style: italic;
    color: var(--color-text-main, #334155);
  }
  .post-content :global(pre) {
    padding: 1rem 1.25rem;
    border-radius: 8px;
    margin: 1.5rem 0;
    overflow-x: auto;
    border: 1px solid var(--color-border-subtle, rgba(255, 255, 255, 0.1));
  }
  .post-content :global(code:not(pre code)) {
    padding: 0.2rem 0.4rem;
    font-size: 0.875em;
    background-color: var(--color-surface, rgba(0, 0, 0, 0.05));
    border-radius: 4px;
    color: var(--color-accent, #2563eb);
  }
  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
  }
  .post-content :global(th),
  .post-content :global(td) {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border-subtle, rgba(0, 0, 0, 0.1));
    text-align: left;
  }
  .post-content :global(th) {
    background-color: var(--color-surface, rgba(0, 0, 0, 0.04));
    font-weight: 600;
  }
  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0;
  }
  .post-content :global(a) {
    color: var(--color-accent, #2563eb);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .post-content :global(a:hover) {
    opacity: 0.85;
  }
</style>
