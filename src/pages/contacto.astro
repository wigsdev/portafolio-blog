---
import BaseLayout from "../layouts/BaseLayout.astro";
import { actions, isInputError } from "astro:actions";

export const prerender = false;

const result = Astro.getActionResult(actions.contact);
const inputErrors = isInputError(result?.error) ? result.error.fields : {};
const isSuccess = Boolean(result && !result.error && result.data?.success);
const generalError =
  result?.error && !isInputError(result.error) ? result.error.message : null;
---

<BaseLayout
  pageTitle="Contacto"
  description="Elige el canal adecuado según lo que tengas en mente o envíame un mensaje directo a través del formulario."
  eyebrow="CONTACTO"
>
  <p class="text-[1.05rem] leading-[1.7] mb-8 text-text">
    ¿Tienes un proyecto en mente, una consulta técnica o simplemente quieres
    conectar? Puedes utilizar cualquiera de mis canales directos o enviarme un
    mensaje mediante el formulario.
  </p>

  {isSuccess && (
    <div
      class="flex items-start gap-3.5 p-5 rounded-[10px] mb-10 bg-emerald-50 border border-emerald-200 text-emerald-800 dark:bg-emerald-600/15 dark:border-emerald-500/40 dark:text-emerald-300"
      role="status"
      aria-live="polite"
    >
      <span
        class="shrink-0 w-5 h-5 mt-0.5 bg-current [mask:var(--icon)_no-repeat_center/contain] [-webkit-mask:var(--icon)_no-repeat_center/contain]"
        style="--icon: url('/icons/ui/check-circle.svg')"
        aria-hidden="true"
      ></span>
      <div>
        <h3 class="m-0 mb-1.5 text-[1.05rem] font-bold">
          ¡Mensaje recibido con éxito!
        </h3>
        <p class="m-0 mb-3 text-[0.95rem] leading-normal">
          {result?.data?.message}
        </p>
        <a
          href="/contacto/"
          class="inline-flex min-h-9 items-center justify-center px-3.5 py-1.5 rounded-lg text-sm font-semibold no-underline cursor-pointer bg-surface text-text border border-border transition-colors hover:bg-surface-muted hover:border-text-muted"
        >
          Enviar otro mensaje
        </a>
      </div>
    </div>
  )}

  {generalError && (
    <div
      class="flex items-start gap-3.5 p-5 rounded-[10px] mb-10 bg-red-50 border border-red-200 text-red-800 dark:bg-red-600/15 dark:border-red-500/40 dark:text-red-300"
      role="alert"
    >
      <span
        class="shrink-0 w-5 h-5 mt-0.5 bg-current [mask:var(--icon)_no-repeat_center/contain] [-webkit-mask:var(--icon)_no-repeat_center/contain]"
        style="--icon: url('/icons/ui/alert-circle.svg')"
        aria-hidden="true"
      ></span>
      <div>
        <h3 class="m-0 mb-1.5 text-[1.05rem] font-bold">Ocurrió un error</h3>
        <p class="m-0 text-[0.95rem] leading-normal">{generalError}</p>
      </div>
    </div>
  )}

  {!isSuccess && (
    <section class="mt-4 pb-10" aria-labelledby="form-heading">
      <h2 id="form-heading" class="text-2xl font-bold mt-0 mb-2 text-text">
        Envíame un mensaje directo
      </h2>
      <p class="mb-6 text-text-muted text-[0.95rem]">
        Todos los campos marcados con{" "}
        <span class="text-brand font-bold" aria-hidden="true">
          *
        </span>{" "}
        son obligatorios y se validan en el servidor mediante Zod.
      </p>

      <form
        method="POST"
        action={actions.contact}
        class="flex flex-col gap-5 max-w-176"
        novalidate
        id="contact-form"
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="flex flex-col gap-1.5">
            <label for="nombre" class="text-[0.925rem] font-semibold text-text">
              Nombre completo{" "}
              <span class="text-brand font-bold" aria-hidden="true">
                *
              </span>
            </label>
            <input
              type="text"
              id="nombre"
              name="nombre"
              required
              aria-required="true"
              aria-invalid={inputErrors.nombre ? "true" : undefined}
              aria-describedby={inputErrors.nombre ? "nombre-error" : undefined}
              placeholder="Ej. Ana García"
              autocomplete="name"
              class="w-full py-3 px-4 font-inherit text-[0.975rem] text-text bg-surface border border-border rounded-lg transition-all duration-160 focus:outline-none focus:border-brand focus:ring-3 focus:ring-brand-soft aria-invalid:border-red-600"
            />
            {inputErrors.nombre && (
              <p
                id="nombre-error"
                class="m-0 text-red-600 dark:text-red-300 text-[0.85rem] font-medium"
                role="alert"
              >
                {inputErrors.nombre[0]}
              </p>
            )}
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="email" class="text-[0.925rem] font-semibold text-text">
              Correo electrónico{" "}
              <span class="text-brand font-bold" aria-hidden="true">
                *
              </span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              aria-required="true"
              aria-invalid={inputErrors.email ? "true" : undefined}
              aria-describedby={inputErrors.email ? "email-error" : undefined}
              placeholder="ana@ejemplo.com"
              autocomplete="email"
              class="w-full py-3 px-4 font-inherit text-[0.975rem] text-text bg-surface border border-border rounded-lg transition-all duration-160 focus:outline-none focus:border-brand focus:ring-3 focus:ring-brand-soft aria-invalid:border-red-600"
            />
            {inputErrors.email && (
              <p
                id="email-error"
                class="m-0 text-red-600 dark:text-red-300 text-[0.85rem] font-medium"
                role="alert"
              >
                {inputErrors.email[0]}
              </p>
            )}
          </div>
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="asunto" class="text-[0.925rem] font-semibold text-text">
            Asunto{" "}
            <span class="text-brand font-bold" aria-hidden="true">
              *
            </span>
          </label>
          <input
            type="text"
            id="asunto"
            name="asunto"
            required
            aria-required="true"
            aria-invalid={inputErrors.asunto ? "true" : undefined}
            aria-describedby={inputErrors.asunto ? "asunto-error" : undefined}
            placeholder="Ej. Propuesta de desarrollo o consulta técnica"
            class="w-full py-3 px-4 font-inherit text-[0.975rem] text-text bg-surface border border-border rounded-lg transition-all duration-160 focus:outline-none focus:border-brand focus:ring-3 focus:ring-brand-soft aria-invalid:border-red-600"
          />
          {inputErrors.asunto && (
            <p
              id="asunto-error"
              class="m-0 text-red-600 dark:text-red-300 text-[0.85rem] font-medium"
              role="alert"
            >
              {inputErrors.asunto[0]}
            </p>
          )}
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="mensaje" class="text-[0.925rem] font-semibold text-text">
            Mensaje{" "}
            <span class="text-brand font-bold" aria-hidden="true">
              *
            </span>
          </label>
          <textarea
            id="mensaje"
            name="mensaje"
            rows="5"
            required
            aria-required="true"
            aria-invalid={inputErrors.mensaje ? "true" : undefined}
            aria-describedby={inputErrors.mensaje ? "mensaje-error" : undefined}
            placeholder="Cuéntame sobre tu proyecto, objetivos o la consulta que deseas realizar..."
            class="w-full py-3 px-4 font-inherit text-[0.975rem] text-text bg-surface border border-border rounded-lg transition-all duration-160 focus:outline-none focus:border-brand focus:ring-3 focus:ring-brand-soft aria-invalid:border-red-600 resize-y min-h-28"
          ></textarea>
          {inputErrors.mensaje && (
            <p
              id="mensaje-error"
              class="m-0 text-red-600 dark:text-red-300 text-[0.85rem] font-medium"
              role="alert"
            >
              {inputErrors.mensaje[0]}
            </p>
          )}
        </div>

        <div class="mt-2">
          <button
            type="submit"
            class="inline-flex items-center justify-center py-2.5 px-5 rounded-lg text-sm font-semibold no-underline cursor-pointer bg-brand text-text-inverse border border-transparent transition-colors duration-150 hover:bg-brand-hover focus-visible:outline-2 focus-visible:outline-brand focus-visible:outline-offset-3"
            id="submit-btn"
          >
            Enviar mensaje
          </button>
        </div>
      </form>
    </section>
  )}

  <section class="mt-10 pt-8 border-t border-border">
    <h2 class="text-2xl font-bold mt-0 mb-2 text-text">
      ¿Quieres trabajar en algo juntos?
    </h2>
    <p class="mb-5 text-text-muted">
      He trabajado en proyectos individuales y equipos multidisciplinarios. Si
      buscas colaboración profesional o consultoría, puedes escribirme
      directamente.
    </p>
    <div class="flex flex-wrap items-center gap-6">
      <a
        href="mailto:karlwgs1989@gmail.com"
        class="inline-flex items-center gap-2 text-brand font-bold no-underline transition-all duration-160 hover:text-brand-hover hover:underline hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-brand-hover focus-visible:outline-offset-3 rounded"
      >
        <span
          class="inline-block w-4.5 h-4.5 bg-current shrink-0 [mask:var(--icon)_no-repeat_center/contain] [-webkit-mask:var(--icon)_no-repeat_center/contain]"
          style="--icon: url('/icons/social/email.svg')"
          aria-hidden="true"
        ></span>
        <span>karlwgs1989@gmail.com</span>
      </a>
      <a
        href="https://www.linkedin.com/in/wigsdev/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-brand font-bold no-underline transition-all duration-160 hover:text-brand-hover hover:underline hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-brand-hover focus-visible:outline-offset-3 rounded"
      >
        <span
          class="inline-block w-4.5 h-4.5 bg-current shrink-0 [mask:var(--icon)_no-repeat_center/contain] [-webkit-mask:var(--icon)_no-repeat_center/contain]"
          style="--icon: url('/icons/social/linkedin.svg')"
          aria-hidden="true"
        ></span>
        <span>LinkedIn</span>
      </a>
    </div>
  </section>

  <section class="mt-10 pt-8 border-t border-border">
    <h2 class="text-2xl font-bold mt-0 mb-2 text-text">
      ¿Solo quieres saludar?
    </h2>
    <p class="mb-5 text-text-muted">
      Conecta a través de mis redes sociales profesionales o comunitarias.
    </p>
    <div class="flex flex-wrap items-center gap-6">
      <a
        href="https://github.com/wigsdev"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-brand font-bold no-underline transition-all duration-160 hover:text-brand-hover hover:underline hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-brand-hover focus-visible:outline-offset-3 rounded"
      >
        <span
          class="inline-block w-4.5 h-4.5 bg-current shrink-0 [mask:var(--icon)_no-repeat_center/contain] [-webkit-mask:var(--icon)_no-repeat_center/contain]"
          style="--icon: url('/icons/social/github.svg')"
          aria-hidden="true"
        ></span>
        <span>GitHub</span>
      </a>
      <a
        href="https://www.instagram.com/wigsdev/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-brand font-bold no-underline transition-all duration-160 hover:text-brand-hover hover:underline hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-brand-hover focus-visible:outline-offset-3 rounded"
      >
        <span
          class="inline-block w-4.5 h-4.5 bg-current shrink-0 [mask:var(--icon)_no-repeat_center/contain] [-webkit-mask:var(--icon)_no-repeat_center/contain]"
          style="--icon: url('/icons/social/instagram.svg')"
          aria-hidden="true"
        ></span>
        <span>Instagram</span>
      </a>
      <a
        href="https://web.facebook.com/wilmergulcochia/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-brand font-bold no-underline transition-all duration-160 hover:text-brand-hover hover:underline hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-brand-hover focus-visible:outline-offset-3 rounded"
      >
        <span
          class="inline-block w-4.5 h-4.5 bg-current shrink-0 [mask:var(--icon)_no-repeat_center/contain] [-webkit-mask:var(--icon)_no-repeat_center/contain]"
          style="--icon: url('/icons/social/facebook.svg')"
          aria-hidden="true"
        ></span>
        <span>Facebook</span>
      </a>
    </div>
  </section>
</BaseLayout>
