---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const posts = await getCollection("blog");

// Conteo de artículos por etiqueta: { astro: 5, css: 1, ... }
const tagcounts = posts
  .flatMap((post) => post.data.tags)
  .reduce<Record<string, number>>((acc, tag) => {
    acc[tag] = (acc[tag] ?? 0) + 1;
    return acc;
  }, {});

// Más usadas primero: si empatan, orden alfabético
const tags = Object.entries(tagcounts).sort(
  ([tagA, countA], [tagB, countB]) =>
    countB - countA || tagA.localeCompare(tagB),
);
---

<BaseLayout
  pageTitle="Etiquetas"
  eyebrow="Explorar por tema"
  description="Explora los artículos de blog organizados por etiquetas: Astro, TypeScript, arquitectura, IA, datos y más."
>
  <ul class="flex flex-wrap gap-3 m-0 p-0 list-none">
    {tags.map(([tag, count]) => (
      <li>
        <a
          href={`/blog/tags/${tag}/`}
          class="inline-flex items-center gap-2 py-2 pl-4 pr-2 border border-border rounded-full bg-surface text-text text-[0.9375rem] font-semibold no-underline transition-all duration-150 hover:border-brand hover:text-brand hover:-translate-y-px"
        >
          <span>{tag}</span>
          <span
            class="min-w-7 py-0.5 px-2 rounded-full bg-surface-muted text-text-muted text-[0.8125rem] text-center"
            aria-label={`${count} artículos`}
          >
            {count}
          </span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
