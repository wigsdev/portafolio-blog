---
import type { GetStaticPaths } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogCard from "../../../components/BlogCard.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  // Etiquetas únicas de toda la colección (Set elimina duplicados)
  const uniqueTags = [...new Set(posts.flatMap((post) => post.data.tags))];

  // Una página estática por etiqueta, con solo sus artículos
  return uniqueTags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { tag } = Astro.params;
const { posts } = Astro.props;
const countLabel = posts.length === 1 ? "artículo" : "artículos";
---

<BaseLayout
  pageTitle={tag}
  eyebrow="Etiqueta"
  description={`Artículos técnicos sobre ${tag}: desarrollo web, buenas prácticas y arquitectura de software.`}
>
  <div class="flex flex-wrap items-center justify-between gap-3 mb-8">
    <p class="m-0 text-[0.9375rem] text-text-muted">
      {posts.length} {countLabel}
    </p>
    <a
      href="/blog/tags/"
      class="inline-flex items-center gap-1 text-brand font-bold no-underline transition-all duration-150 hover:text-brand-hover hover:underline hover:translate-x-0.75"
    >
      Ver todas las etiquetas &rarr;
    </a>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {posts.map((post) => (
      <BlogCard post={post} />
    ))}
  </div>
</BaseLayout>
