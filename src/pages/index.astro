---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { proyectos } from "../data/projects";

const proyectosDestacados = proyectos.filter((p) => p.destacado);
---

<BaseLayout
  pageTitle="Construyendo aplicaciones web rápidas, modernas e inteligentes"
  description="Hola, soy Wilmer Gulcochia, desarrollador web fullstack con IA. Explora mis proyectos y escríbeme."
  mainClass="hero"
>
  <p>Hola, soy Wilmer Gulcochia, desarrollador web fullstack con IA.</p>

  <p>
    Creo aplicaciones web rápidas y modernas con Astro, TypeScript e integración
    de IA.
  </p>

  <p>
    Enfocado en Core Web Vitals, arquitectura de islas, código limpio y
    experiencias de usuario inteligentes.
  </p>

  <div class="hero-actions">
    <a href="/proyectos/" class="btn btn--primary"> Ver proyectos </a>
    <a href="/contacto/" class="btn btn--secondary"> Escríbeme </a>
  </div>

  <section class="seccion-proyectos">
    <div class="seccion-header">
      <h2>Proyectos</h2>
      <a href="/proyectos/" class="seccion-link"
        >Ver todos los proyectos &rarr;</a
      >
    </div>
    <div class="proyectos-grid">
      {
        proyectosDestacados.map((proyecto, index) => (
          <ProjectCard {...proyecto} loading={index < 2 ? "eager" : "lazy"} />
        ))
      }
    </div>
  </section>
</BaseLayout>
