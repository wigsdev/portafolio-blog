---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BlogCard from "../components/BlogCard.astro";
import { getCollection } from "astro:content";
import { proyectos } from "../data/projects";

const proyectosDestacados = proyectos.filter((p) => p.destacado);

// Obtener los 3 artículos más recientes ordenados por fecha
const articulosRecientes = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  pageTitle="Construyendo aplicaciones web rápidas, modernas e inteligentes"
  description="Hola, soy Wilmer Gulcochia, desarrollador web fullstack con IA. Explora mis proyectos y escríbeme."
  mainClass="has-sections"
  hideTitle={true}
>
  <!-- Sección Hero -->
  <section class="section section--hero">
    <div class="container">
      <h1>Construyendo aplicaciones web rápidas, modernas e inteligentes</h1>
      <p>Hola, soy Wilmer Gulcochia, desarrollador web fullstack con IA.</p>
      <p>
        Creo aplicaciones web rápidas y modernas con Astro, TypeScript e
        integración de IA.
      </p>
      <p>
        Enfocado en Core Web Vitals, arquitectura de islas, código limpio y
        experiencias de usuario inteligentes.
      </p>

      <div class="hero-actions">
        <a href="/proyectos/" class="btn btn--primary">
          {" "}
          Ver proyectos{" "}
        </a>
        <a href="/contacto/" class="btn btn--secondary">
          {" "}
          Escríbeme{" "}
        </a>
      </div>
    </div>
  </section>

  <!-- Sección Proyectos -->
  <section class="section section--proyectos">
    <div class="container">
      <div class="seccion-header">
        <h2>Proyectos</h2>
        <a href="/proyectos/" class="seccion-link">
          Ver todos los proyectos &rarr;
        </a>
      </div>
      <div class="proyectos-grid">
        {proyectosDestacados.map((proyecto, index) => (
          <ProjectCard {...proyecto} loading={index < 2 ? "eager" : "lazy"} />
        ))}
      </div>
    </div>
  </section>

  <!-- Sección Blog / Artículos -->
  <section class="section section--blog">
    <div class="container">
      <div class="seccion-header">
        <h2>Artículos recientes</h2>
        <a href="/blog/" class="seccion-link">
          Ir al blog &rarr;
        </a>
      </div>
      <div class="cards-grid blog-grid-home">
        {articulosRecientes.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-grid-home {
    margin-top: 1.5rem;
  }
</style>
