---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BlogCard from "../components/BlogCard.astro";
import { getCollection } from "astro:content";
import { proyectos } from "../data/projects";

const proyectosDestacados = proyectos.filter((p) => p.destacado);

// Obtener los 3 artículos más recientes ordenados por fecha
const articulosRecientes = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  pageTitle="Construyendo aplicaciones web rápidas, modernas e inteligentes"
  description="Hola, soy Wilmer Gulcochia, desarrollador web fullstack con IA. Explora mis proyectos y escríbeme."
  mainClass="has-sections"
  hideTitle={true}
>
  <!-- Sección Hero -->
  <section class="w-full border-t-0 pt-12 pb-20">
    <div class="w-full max-w-240 lg:max-w-6xl mx-auto px-4 md:px-8">
      <h1 class="text-[clamp(2rem,5vw,3.5rem)] font-bold leading-tight tracking-tight mt-0 mb-4 text-text">
        Construyendo aplicaciones web rápidas, modernas e inteligentes
      </h1>
      <p class="max-w-[65ch] text-text text-base leading-relaxed mb-3">
        Hola, soy Wilmer Gulcochia, desarrollador web fullstack con IA.
      </p>
      <p class="max-w-[65ch] text-text text-base leading-relaxed mb-3">
        Creo aplicaciones web rápidas y modernas con Astro, TypeScript e
        integración de IA.
      </p>
      <p class="max-w-[65ch] text-text text-base leading-relaxed mb-3">
        Enfocado en Core Web Vitals, arquitectura de islas, código limpio y
        experiencias de usuario inteligentes.
      </p>

      <div class="flex flex-wrap gap-3 mt-7">
        <a
          href="/proyectos/"
          class="inline-flex items-center justify-center py-2.5 px-5 rounded-lg text-sm font-semibold no-underline cursor-pointer bg-brand text-text-inverse border border-transparent transition-colors duration-150 hover:bg-brand-hover focus-visible:outline-2 focus-visible:outline-brand focus-visible:outline-offset-3"
        >
          Ver proyectos
        </a>
        <a
          href="/contacto/"
          class="inline-flex items-center justify-center py-2.5 px-5 rounded-lg text-sm font-semibold no-underline cursor-pointer bg-surface text-text border border-border transition-colors duration-150 hover:bg-surface-muted hover:border-text-muted focus-visible:outline-2 focus-visible:outline-brand focus-visible:outline-offset-3"
        >
          Escríbeme
        </a>
      </div>
    </div>
  </section>

  <!-- Sección Proyectos -->
  <section class="w-full py-20 border-t border-border">
    <div class="w-full max-w-240 lg:max-w-6xl mx-auto px-4 md:px-8">
      <div class="flex justify-between items-baseline flex-wrap gap-2">
        <h2 class="text-2xl font-bold m-0 text-text">Proyectos</h2>
        <a
          href="/proyectos/"
          class="inline-flex items-center gap-1 text-brand font-bold no-underline transition-all duration-150 hover:text-brand-hover hover:underline hover:translate-x-0.75"
        >
          Ver todos los proyectos &rarr;
        </a>
      </div>
      <div class="mt-6 grid grid-cols-[repeat(auto-fit,minmax(min(100%,19rem),1fr))] gap-6">
        {proyectosDestacados.map((proyecto, index) => (
          <ProjectCard {...proyecto} loading={index < 2 ? "eager" : "lazy"} />
        ))}
      </div>
    </div>
  </section>

  <!-- Sección Blog / Artículos -->
  <section class="w-full py-20 border-t border-border">
    <div class="w-full max-w-240 lg:max-w-6xl mx-auto px-4 md:px-8">
      <div class="flex justify-between items-baseline flex-wrap gap-2">
        <h2 class="text-2xl font-bold m-0 text-text">Artículos recientes</h2>
        <a
          href="/blog/"
          class="inline-flex items-center gap-1 text-brand font-bold no-underline transition-all duration-150 hover:text-brand-hover hover:underline hover:translate-x-0.75"
        >
          Ir al blog &rarr;
        </a>
      </div>
      <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {articulosRecientes.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
