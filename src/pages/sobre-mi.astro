---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import CredentialCard from "../components/CredentialCard.astro";
import { certificaciones, formaciones } from "../data/credentials";
import profilePhoto from "../assets/foto.jpg";
---

<BaseLayout
  pageTitle="Sobre mí"
  description="Conoce mi trayectoria como desarrollador web full-stack, especialista en soluciones con IA y credenciales técnicas internacionales."
  eyebrow="CONÓCEME"
>
  <!-- 1. Sección Perfil: Contenido original + Tarjeta de Perfil -->
  <section
    class="flex flex-col-reverse items-center gap-8 mb-14 md:flex-row md:items-start md:gap-12"
    aria-label="Perfil profesional"
  >
    <div class="flex-1 min-w-0">
      <p class="text-lg leading-[1.65] text-text mt-0 mb-3">
        Soy desarrollador web full-stack enfocado en construir aplicaciones
        rápidas, modernas e inteligentes. Trabajo principalmente con{" "}
        <strong>Astro</strong>, <strong>TypeScript</strong> y tecnologías web
        modernas, priorizando la arquitectura limpia, el rendimiento de Core Web
        Vitals y una experiencia de usuario sólida.
      </p>

      <p class="max-w-[65ch] text-text text-base leading-relaxed mb-3">
        Me especializo en integrar la <strong>Inteligencia Artificial</strong>{" "}
        en productos digitales reales: desde sistemas de recuperación aumentada
        (RAG) y agentes autónomos, hasta interfaces web reactivas y accesibles.
        Mi experiencia previa en análisis de datos y sistemas espaciales me
        brinda un enfoque analítico y riguroso para resolver problemas
        complejos.
      </p>

      <div class="flex flex-wrap gap-3 mt-8">
        <a
          href="/cv.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center py-2.5 px-5 rounded-lg text-sm font-semibold no-underline cursor-pointer bg-brand text-text-inverse border border-transparent transition-colors duration-150 hover:bg-brand-hover focus-visible:outline-2 focus-visible:outline-brand focus-visible:outline-offset-3"
        >
          Ver mi CV (PDF)
        </a>
        <a
          href="/contacto/"
          class="inline-flex items-center justify-center py-2.5 px-5 rounded-lg text-sm font-semibold no-underline cursor-pointer bg-surface text-text border border-border transition-colors duration-150 hover:bg-surface-muted hover:border-text-muted focus-visible:outline-2 focus-visible:outline-brand focus-visible:outline-offset-3"
        >
          Contáctame
        </a>
      </div>
    </div>

    <!-- Tarjeta de Retrato Profesional -->
    <aside
      class="shrink-0 p-4 bg-surface border border-border rounded-2xl flex flex-col items-center gap-3.5 shadow-[0_4px_16px_rgba(0,0,0,0.06)] transition-colors duration-200"
      aria-label="Ficha de presentación"
    >
      <div class="w-45 h-45 md:w-50 md:h-50 rounded-xl overflow-hidden bg-background">
        <Image
          src={profilePhoto}
          alt="Fotografía de Wilmer Gulcochia"
          width={200}
          height={200}
          densities={[1, 1.25]}
          loading="eager"
          fetchpriority="high"
          class="w-full h-full object-cover block"
        />
      </div>
      <div class="flex flex-col items-center gap-1.5 w-full">
        <div class="inline-flex items-center gap-1.5 text-[0.8125rem] font-semibold text-text">
          <span
            class="w-2 h-2 rounded-full bg-emerald-500 shrink-0 animate-pulse motion-reduce:animate-none"
            aria-hidden="true"
          ></span>
          <span>Disponible para proyectos</span>
        </div>
        <div class="inline-flex items-center gap-1.5 text-[0.8125rem] text-text-muted">
          <span
            class="inline-block w-3.75 h-3.75 shrink-0 bg-brand [mask:var(--icon)_no-repeat_center/contain] [-webkit-mask:var(--icon)_no-repeat_center/contain]"
            style="--icon: url('/icons/ui/map-pin.svg')"
            aria-hidden="true"
          ></span>
          <span>Uchiza, Perú</span>
        </div>
      </div>
    </aside>
  </section>

  <!-- 2. Sección Certificaciones -->
  <section class="mb-14" aria-labelledby="cert-title">
    <h2 id="cert-title" class="text-2xl font-bold mt-8 mb-2 text-text">
      Certificaciones
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-5 mt-6">
      {certificaciones.map((cert) => (
        <CredentialCard {...cert} />
      ))}
    </div>
  </section>

  <!-- 3. Sección Formación Continua -->
  <section class="mb-14" aria-labelledby="formacion-title">
    <h2 id="formacion-title" class="text-2xl font-bold mt-8 mb-2 text-text">
      Formación continua
    </h2>
    <p class="max-w-[65ch] my-2 mb-6 text-text-muted">
      Complemento mi formación de base en ciencias con programas intensivos de
      especialización técnica y desarrollo de software:
    </p>

    <div class="grid grid-cols-1 md:grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-5 mt-6">
      {formaciones.map((formacion) => (
        <CredentialCard {...formacion} />
      ))}
    </div>
  </section>
</BaseLayout>
