---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { proyectos } from "../data/projects";
---

<BaseLayout
  pageTitle="Proyectos"
  description="Explora proyectos de desarrollo, sus tecnologías y enlaces a demos y repositorios."
  eyebrow="PROYECTOS PERSONALES"
>
  <p class="max-w-[65ch] text-text text-base leading-relaxed mb-6">
    Proyectos destacados con foco en código limpio, Core Web Vitals e interfaces
    interactivas.
  </p>

  <div class="mt-6 grid grid-cols-[repeat(auto-fit,minmax(min(100%,19rem),1fr))] gap-6">
    {proyectos.map((proyecto, index) => (
      <ProjectCard {...proyecto} loading={index < 3 ? "eager" : "lazy"} />
    ))}
  </div>

  <section class="mt-14 pt-8 border-t border-border">
    <h2 class="text-2xl font-bold mt-0 mb-2 text-text">
      Explora más en GitHub
    </h2>
    <p class="max-w-[65ch] text-text text-base leading-relaxed mb-6">
      Encuentra más proyectos, experimentos personales y código abierto en mi
      perfil.
    </p>
    <a
      href="https://github.com/wigsdev"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center py-2.5 px-5 rounded-lg text-sm font-semibold no-underline cursor-pointer bg-surface text-text border border-border transition-colors duration-150 hover:bg-surface-muted hover:border-text-muted focus-visible:outline-2 focus-visible:outline-brand focus-visible:outline-offset-3"
    >
      Ver mi GitHub
    </a>
  </section>
</BaseLayout>
