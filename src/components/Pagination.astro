---
import type { Page } from "astro";

interface Props {
  page: Page<any>;
}

const { page } = Astro.props;

const btnBaseClass =
  "inline-flex items-center justify-center min-h-10 px-4 py-2 border border-border rounded-lg bg-surface text-text text-sm font-semibold no-underline transition-colors focus-visible:outline-2 focus-visible:outline-brand focus-visible:outline-offset-2";
const btnActiveClass =
  "hover:border-brand hover:bg-brand-soft hover:text-brand";
const btnDisabledClass =
  "opacity-40 cursor-not-allowed pointer-events-none text-text-muted";
---

{page.lastPage > 1 && (
  <nav class="flex items-center justify-center flex-wrap gap-4 mt-14 pt-8 border-t border-border" aria-label="Paginación de artículos">
    {page.url.prev ? (
      <a href={page.url.prev} class:list={[btnBaseClass, btnActiveClass]} rel="prev">
        &larr; Anterior
      </a>
    ) : (
      <span class:list={[btnBaseClass, btnDisabledClass]} aria-disabled="true">
        &larr; Anterior
      </span>
    )}
    <span class="text-sm text-text-muted px-2 [&>strong]:text-text">
      Página <strong>{page.currentPage}</strong> de{" "}
      <strong>{page.lastPage}</strong>
    </span>
    {page.url.next ? (
      <a href={page.url.next} class:list={[btnBaseClass, btnActiveClass]} rel="next">
        Siguiente &rarr;
      </a>
    ) : (
      <span class:list={[btnBaseClass, btnDisabledClass]} aria-disabled="true">
        Siguiente &rarr;
      </span>
    )}
  </nav>
)}
