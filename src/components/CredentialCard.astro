---
import type { Credencial } from "../data/credentials";

interface Props extends Credencial {}

const { emisor, periodo, titulo, descripcion, pie, urlVerificacion } = Astro.props;
---

<article class="cert-card">
  <header class="cert-card-header">
    <span class="cert-badge">{emisor}</span>
    <span class="cert-period">{periodo}</span>
  </header>

  <h3 class="cert-card-title">
    {urlVerificacion ? (
      <a href={urlVerificacion} target="_blank" rel="noopener noreferrer" class="cert-title-link">
        {titulo}
      </a>
    ) : (
      titulo
    )}
  </h3>

  <p class="cert-card-desc">
    {descripcion}
  </p>

  <footer class="cert-card-footer">
    <span class="cert-code">{pie}</span>
  </footer>
</article>

<style>
  .cert-card {
    display: flex;
    flex-direction: column;
    padding: 1.375rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.875rem;
    transition:
      transform 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  .cert-card:hover {
    border-color: var(--color-brand);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .cert-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-block-end: 0.875rem;
  }

  .cert-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-brand);
  }

  .cert-period {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .cert-card-title {
    font-size: 1.0625rem;
    line-height: 1.35;
    margin: 0 0 0.625rem;
    color: var(--color-text);
  }

  .cert-title-link {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .cert-title-link:hover {
    color: var(--color-brand);
  }

  .cert-card-desc {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0;
    flex-grow: 1;
  }

  .cert-card-footer {
    margin-block-start: 1.25rem;
    padding-block-start: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .cert-code {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }
</style>
