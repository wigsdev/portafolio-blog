---
import type { Credencial } from "../data/credentials";

interface Props extends Credencial {}

const { emisor, periodo, titulo, descripcion, pie, urlVerificacion } = Astro.props;
---

<article
  class="flex flex-col p-5.5 bg-surface border border-border rounded-[0.875rem] transition-all duration-200 hover:border-brand hover:-translate-y-0.5 hover:shadow-lg"
>
  <header class="flex justify-between items-center gap-2 mb-3.5">
    <span class="text-xs font-bold uppercase tracking-wider text-brand">{emisor}</span>
    <span class="text-xs font-medium text-text-muted">{periodo}</span>
  </header>

  <h3 class="text-[1.0625rem] leading-[1.35] mb-2.5 text-text font-bold">
    {urlVerificacion ? (
      <a href={urlVerificacion} target="_blank" rel="noopener noreferrer" class="text-inherit no-underline transition-colors hover:text-brand">
        {titulo}
      </a>
    ) : (
      titulo
    )}
  </h3>

  <p class="text-sm leading-relaxed text-text-muted m-0 grow">
    {descripcion}
  </p>

  <footer class="mt-5 pt-3 border-t border-border">
    <span class="text-xs font-semibold text-text-muted tracking-wide">{pie}</span>
  </footer>
</article>
