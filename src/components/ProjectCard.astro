---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Badge from "./Badge.astro";

interface Props {
  nombre: string;
  descripcion: string;
  tecnologias: string[];
  imagen: ImageMetadata;
  imagenAlt?: string;
  loading?: "eager" | "lazy";
  demoUrl?: string;
  demoUnavailableMessage?: string;
  githubUrl: string;
}

const {
  nombre,
  descripcion,
  tecnologias,
  imagen,
  imagenAlt = `Captura o ilustración del proyecto ${nombre}`,
  loading = "lazy",
  demoUrl,
  demoUnavailableMessage = "Demo no disponible",
  githubUrl,
} = Astro.props;
---

<article class="project-card">
  <Image
    class="project-preview"
    src={imagen}
    alt={imagenAlt}
    width={640}
    height={360}
    loading={loading}
  />

  <ul class="project-technologies" aria-label="Tecnologías utilizadas">
    {
      tecnologias.slice(0, 3).map((tecnologia) => (
        <li class="technology-chip">
          <Badge text={tecnologia} />
        </li>
      ))
    }
  </ul>

  <h2>{nombre}</h2>

  <p class="project-description">{descripcion}</p>
  {
    /* Slot opcional para notas adicionales, métricas o etiquetas personalizadas */
  }
  {
    Astro.slots.has("default") && (
      <div class="project-extra">
        <slot />
      </div>
    )
  }
  <div class="project-actions">
    {
      demoUrl ? (
        <a
          class="project-demo"
          href={demoUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Demo
        </a>
      ) : (
        <span class="project-demo unavailable" aria-disabled="true">
          {demoUnavailableMessage}
        </span>
      )
    }

    <a
      class="project-repository"
      href={githubUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      GitHub
    </a>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
  }

  .project-card h2 {
    margin: 0.5rem 0 0;
  }

  .project-description {
    margin: 0.5rem 0 0;
  }

  .project-preview {
    display: grid;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    place-items: center;
    border-radius: 0.5rem;
    color: var(--color-text-muted);
    background-color: var(--color-surface-muted);
    text-align: center;
  }

  .project-technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .technology-chip {
    padding: 0;
    margin: 0;
  }

  .project-extra {
    margin-top: 0.5rem;
  }

  .project-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .project-actions a,
  .unavailable {
    display: inline-flex;
    min-height: 2.5rem;
    box-sizing: border-box;
    align-items: center;
    justify-content: center;
    padding: 0.375rem 0.625rem;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .project-demo {
    color: var(--color-text-inverse);
    background-color: var(--color-brand);
    text-decoration: none;
  }

  a.project-demo:hover {
    background-color: var(--color-brand-hover);
  }

  .project-actions a:focus-visible {
    outline: 2px solid var(--color-brand-hover);
    outline-offset: 3px;
  }

  .project-actions .project-repository {
    border: 1px solid var(--color-github);
    color: var(--color-github);
    background-color: var(--color-surface);
    text-decoration: none;
  }

  .project-actions .project-repository:hover {
    border-color: var(--color-github);
    color: var(--color-github);
    background-color: var(--color-github-hover-bg);
  }

  .unavailable {
    color: var(--color-text-muted);
    background-color: var(--color-surface-muted);
    font-weight: 500;
  }

  @media (max-width: 22rem) {
    .project-actions a,
    .project-actions .unavailable {
      padding-inline: 0.625rem;
      font-size: 0.8125rem;
    }
  }
</style>
