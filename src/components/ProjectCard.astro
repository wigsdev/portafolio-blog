---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Badge from "./Badge.astro";

interface Props {
  nombre: string;
  descripcion: string;
  tecnologias: string[];
  imagen: ImageMetadata;
  imagenAlt?: string;
  loading?: "eager" | "lazy";
  demoUrl?: string;
  demoUnavailableMessage?: string;
  githubUrl: string;
}

const {
  nombre,
  descripcion,
  tecnologias,
  imagen,
  imagenAlt = `Captura o ilustración del proyecto ${nombre}`,
  loading = "lazy",
  demoUrl,
  demoUnavailableMessage = "Demo no disponible",
  githubUrl,
} = Astro.props;

const actionBaseClass =
  "inline-flex min-h-10 items-center justify-center px-2.5 py-1.5 rounded-lg text-[0.85rem] font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-brand-hover focus-visible:outline-offset-2 no-underline";
---

<article class="flex flex-col h-full p-4 border border-border rounded-lg bg-surface transition-all duration-180 hover:-translate-y-1 hover:shadow-[0_8px_20px_var(--color-shadow-brand)] motion-reduce:transition-none motion-reduce:hover:translate-none">
  <Image
    class="w-full aspect-video object-cover rounded-lg text-text-muted bg-surface-muted text-center"
    src={imagen}
    alt={imagenAlt}
    width={640}
    height={360}
    loading={loading}
  />

  <ul
    class="flex flex-wrap gap-2 mt-3 p-0 list-none"
    aria-label="Tecnologías utilizadas"
  >
    {tecnologias.slice(0, 3).map((tecnologia) => (
      <li class="p-0 m-0">
        <Badge text={tecnologia} />
      </li>
    ))}
  </ul>

  <h2 class="mt-2 text-xl font-bold leading-tight text-text">{nombre}</h2>

  <p class="mt-2 text-text-muted leading-relaxed text-sm grow">{descripcion}</p>

  {Astro.slots.has("default") && (
    <div class="mt-2">
      <slot />
    </div>
  )}

  <div class="flex items-center justify-between gap-2 mt-auto pt-5">
    {demoUrl ? (
      <a
        class:list={[
          actionBaseClass,
          "text-text-inverse bg-brand hover:bg-brand-hover",
        ]}
        href={demoUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Demo
      </a>
    ) : (
      <span
        class:list={[
          actionBaseClass,
          "text-text-muted bg-surface-muted font-medium cursor-not-allowed",
        ]}
        aria-disabled="true"
      >
        {demoUnavailableMessage}
      </span>
    )}

    <a
      class:list={[
        actionBaseClass,
        "border border-github text-github bg-surface hover:bg-github-hover-bg",
      ]}
      href={githubUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      GitHub
    </a>
  </div>
</article>
