---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import Badge from "./Badge.astro";

interface Props {
  post: CollectionEntry<"blog">;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate, heroImage, tags = [] } = post.data;

// Estimación de tiempo de lectura (~200 palabras por minuto)
const words = post.body ? post.body.trim().split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(words / 200));
---

<article class:list={["blog-card", { "blog-card--featured": featured }]}>
  {heroImage && (
    <a
      href={`/blog/${post.id}/`}
      class="blog-card-image-link"
      tabindex="-1"
      aria-hidden="true"
    >
      <Image
        src={heroImage}
        alt={title}
        width={featured ? 800 : 640}
        height={featured ? 450 : 360}
        class="blog-card-image"
        loading={featured ? "eager" : "lazy"}
      />
    </a>
  )}
  <div class="blog-card-body">
    {tags.length > 0 && (
      <div class="blog-card-tags">
        {tags.map((tag) => (
          <a href={`/blog/tags/${tag}/`} class="tag-link">
            <Badge text={tag} />
          </a>
        ))}
      </div>
    )}
    <h3 class="blog-card-title">
      <a href={`/blog/${post.id}/`}>{title}</a>
    </h3>
    <p class="blog-card-description">{description}</p>
    {featured && (
      <a href={`/blog/${post.id}/`} class="blog-card-cta">
        Leer artículo &rarr;
      </a>
    )}
    <footer class="blog-card-footer">
      <div class="blog-card-author-group">
        <img
          src="/foto.jpg"
          alt="Wilmer Gulcochía"
          width="20"
          height="20"
          class="blog-card-avatar"
          loading="lazy"
        />
        <span class="blog-card-author">Wilmer Gulcochía</span>
      </div>
      <div class="blog-card-meta">
        <FormattedDate date={pubDate} />
        <span class="blog-card-separator" aria-hidden="true">
          ·
        </span>
        <span class="reading-time">
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
          {readingTime} min
        </span>
      </div>
    </footer>
  </div>
</article>

<style>
  /* Variante destacada (Horizontal en desktop) */
  @media (min-width: 48rem) {
    .blog-card--featured {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      margin-bottom: 2.5rem;
    }

    .blog-card--featured .blog-card-image-link {
      aspect-ratio: auto;
      height: 100%;
      min-height: 20rem;
    }

    .blog-card--featured .blog-card-body {
      padding: 2rem;
      justify-content: center;
    }

    .blog-card--featured .blog-card-title {
      font-size: clamp(1.5rem, 2.5vw, 1.875rem);
      margin-bottom: 0.75rem;
    }

    .blog-card--featured .blog-card-description {
      font-size: 1rem;
      -webkit-line-clamp: 4;
      line-clamp: 4;
      margin-bottom: 1.5rem;
    }
  }

  .blog-card-cta {
    display: inline-flex;
    align-items: center;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-brand);
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .blog-card-cta:hover {
    text-decoration: underline;
  }
</style>
