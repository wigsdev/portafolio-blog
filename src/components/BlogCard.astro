---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import Badge from "./Badge.astro";
interface Props {
  post: CollectionEntry<"blog">;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
const { title, description, pubDate, heroImage, tags = [] } = post.data;
// Estimación de tiempo de lectura (~200 palabras por minuto)
const words = post.body ? post.body.trim().split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(words / 200));
const primaryTag = tags[0];
---

<article class:list={["blog-card", { "blog-card--featured": featured }]}>
  {heroImage && (
    <a
      href={`/blog/${post.id}/`}
      class="blog-card-image-link"
      tabindex="-1"
      aria-hidden="true"
    >
      <Image
        src={heroImage}
        alt={title}
        width={featured ? 800 : 640}
        height={featured ? 450 : 360}
        class="blog-card-image"
        loading={featured ? "eager" : "lazy"}
      />
    </a>
  )}
  <div class="blog-card-body">
    {tags.length > 0 && (
      <div class="blog-card-tags">
        {tags.map((tag) => (
          <a href={`/blog/tags/${tag}/`} class="tag-link">
            <Badge text={tag} />
          </a>
        ))}
      </div>
    )}
    <h3 class="blog-card-title">
      <a href={`/blog/${post.id}/`}>{title}</a>
    </h3>
    <p class="blog-card-description">{description}</p>
    {featured && (
      <a href={`/blog/${post.id}/`} class="blog-card-cta">
        Leer artículo &rarr;
      </a>
    )}
    <footer class="blog-card-footer">
      <div class="blog-card-author-group">
        <img
          src="/foto.jpg"
          alt="Wilmer Gulcochía"
          width="20"
          height="20"
          class="blog-card-avatar"
          loading="lazy"
        />
        <span class="blog-card-author">Wilmer Gulcochía</span>
      </div>
      <div class="blog-card-meta">
        <FormattedDate date={pubDate} />
        <span class="blog-card-separator" aria-hidden="true">
          ·
        </span>
        <span class="reading-time">
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
          {readingTime} min
        </span>
      </div>
    </footer>
  </div>
</article>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    overflow: hidden;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .blog-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 20px var(--color-shadow-brand);
      border-color: var(--color-brand);
    }
  }
  .blog-card-image-link {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background-color: var(--color-surface-muted);
  }
  .blog-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 240ms ease;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .blog-card:hover .blog-card-image {
      transform: scale(1.03);
    }
  }
  .blog-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem;
  }
  .blog-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 0.75rem;
  }

  .blog-card-title {
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.35;
    margin: 0 0 0.5rem 0;
  }
  .blog-card-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .blog-card-title a:hover {
    color: var(--color-brand);
  }
  .blog-card-description {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0 0 1.25rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }
  .blog-card-author-group,
  .blog-card-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  .blog-card-avatar {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .blog-card-author {
    font-weight: 600;
    color: var(--color-text);
  }
  .blog-card-separator {
    color: var(--color-text-muted);
    opacity: 0.6;
  }
  .reading-time {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  /* Tarjeta destacada (Horizontal en desktop) */
  @media (min-width: 48rem) {
    .blog-card--featured {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      margin-bottom: 2.5rem;
    }

    .blog-card--featured .blog-card-image-link {
      aspect-ratio: auto;
      height: 100%;
      min-height: 20rem;
    }

    .blog-card--featured .blog-card-body {
      padding: 2rem;
      justify-content: center;
    }

    .blog-card--featured .blog-card-title {
      font-size: clamp(1.5rem, 2.5vw, 1.875rem);
      margin-bottom: 0.75rem;
    }

    .blog-card--featured .blog-card-description {
      font-size: 1rem;
      -webkit-line-clamp: 4;
      margin-bottom: 1.5rem;
    }
  }

  .blog-card-cta {
    display: inline-flex;
    align-items: center;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-brand);
    text-decoration: none;
    margin-bottom: 1rem;
  }
  .blog-card-cta:hover {
    text-decoration: underline;
  }
  .blog-card-avatar {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
</style>
