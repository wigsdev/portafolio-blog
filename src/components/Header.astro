---
import Logo from "./Logo.astro";
import Navigation from "./Navigation.astro";
---

<header class="site-header sticky top-0 z-10 w-full py-3 md:py-4 border-b border-border bg-background">
  <div class="header-content flex items-center justify-between gap-4 w-full max-w-4xl lg:max-w-6xl mx-auto px-4 md:px-8">
    <a
      class="brand-link inline-flex shrink-0 items-center gap-2.5 rounded text-inherit no-underline focus-visible:outline-2 focus-visible:outline-brand-hover"
      href="/"
      aria-label="Ir al inicio"
    >
      <Logo />
      <span class="brand-copy flex flex-col justify-center leading-tight">
        <span class="brand-name text-brand text-lg font-bold leading-tight">
          Wilmer Gulcochia
        </span>
        <span class="brand-role text-text-muted text-xs leading-tight">
          Full-stack web developer
        </span>
      </span>
    </a>
    <button
      class="menu-toggle group relative w-11 h-11 p-0 border border-border rounded-lg text-text bg-surface hover:bg-brand-soft cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-brand"
      type="button"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="primary-navigation"
      hidden
    >
      <span class="absolute left-1/2 -translate-x-1/2 w-5 h-0.5 rounded-[1px] bg-current transition-all duration-200 ease-in-out top-[calc(50%-0.375rem)] group-aria-expanded:top-1/2 group-aria-expanded:rotate-45"></span>
      <span class="absolute left-1/2 -translate-x-1/2 w-5 h-0.5 rounded-[1px] bg-current transition-all duration-200 ease-in-out top-1/2 group-aria-expanded:opacity-0"></span>
      <span class="absolute left-1/2 -translate-x-1/2 w-5 h-0.5 rounded-[1px] bg-current transition-all duration-200 ease-in-out top-[calc(50%+0.375rem)] group-aria-expanded:top-1/2 group-aria-expanded:-rotate-45"></span>
    </button>
    <Navigation />
  </div>
</header>

<script>
  document.documentElement.classList.add("js");

  const mobileViewport = window.matchMedia("(max-width: 48rem)");

  const getMenuElements = () => {
    const menuButton =
      document.querySelector<HTMLButtonElement>(".menu-toggle");
    const navigation = document.querySelector<HTMLElement>(
      "#primary-navigation",
    );

    if (!menuButton || !navigation) {
      throw new Error("No se encontró el botón o la navegación del Header.");
    }

    return { menuButton, navigation };
  };

  const setExpanded = (
    menuButton: HTMLButtonElement,
    navigation: HTMLElement,
    expanded: boolean,
  ) => {
    menuButton.setAttribute("aria-expanded", String(expanded));
    menuButton.setAttribute(
      "aria-label",
      expanded ? "Cerrar menú de navegación" : "Abrir menú de navegación",
    );
    navigation.hidden = !expanded;
  };

  const syncViewport = () => {
    const { menuButton, navigation } = getMenuElements();
    const isMobile = mobileViewport.matches;
    menuButton.hidden = !isMobile;
    setExpanded(menuButton, navigation, false);
    navigation.hidden = isMobile;
  };

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) {
      return;
    }

    const { menuButton, navigation } = getMenuElements();

    if (event.target.closest(".menu-toggle")) {
      const isExpanded = menuButton.getAttribute("aria-expanded") === "true";
      setExpanded(menuButton, navigation, !isExpanded);
      return;
    }

    if (event.target.closest("#primary-navigation a")) {
      setExpanded(menuButton, navigation, false);
    }
  });

  document.addEventListener("keydown", (event) => {
    const { menuButton, navigation } = getMenuElements();

    if (
      event.key === "Escape" &&
      menuButton.getAttribute("aria-expanded") === "true"
    ) {
      setExpanded(menuButton, navigation, false);
      menuButton.focus();
    }
  });

  mobileViewport.addEventListener("change", syncViewport);
  document.addEventListener("astro:after-swap", () => {
    document.documentElement.classList.add("js");
  });
  document.addEventListener("astro:page-load", syncViewport);
  syncViewport();
</script>
