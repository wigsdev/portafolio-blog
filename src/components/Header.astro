---
import Logo from "./Logo.astro";
import Navigation from "./Navigation.astro";
---

<header class="site-header">
  <div class="header-content">
    <a class="brand-link" href="/" aria-label="Ir al inicio">
      <Logo />
      <span class="brand-copy">
        <span class="brand-name">Wilmer Gulcochia</span>
        <span class="brand-role">Full-stack web developer</span>
      </span>
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="primary-navigation"
      hidden
    >
      <span class="menu-toggle-line"></span>
      <span class="menu-toggle-line"></span>
      <span class="menu-toggle-line"></span>
    </button>
    <Navigation />
  </div>
</header>

<script>
  document.documentElement.classList.add("js");

  const mobileViewport = window.matchMedia("(max-width: 48rem)");

  const getMenuElements = () => {
    const menuButton =
      document.querySelector<HTMLButtonElement>(".menu-toggle");
    const navigation = document.querySelector<HTMLElement>(
      "#primary-navigation",
    );

    if (!menuButton || !navigation) {
      throw new Error("No se encontró el botón o la navegación del Header.");
    }

    return { menuButton, navigation };
  };

  const setExpanded = (
    menuButton: HTMLButtonElement,
    navigation: HTMLElement,
    expanded: boolean,
  ) => {
    menuButton.setAttribute("aria-expanded", String(expanded));
    menuButton.setAttribute(
      "aria-label",
      expanded ? "Cerrar menú de navegación" : "Abrir menú de navegación",
    );
    navigation.hidden = !expanded;
  };

  const syncViewport = () => {
    const { menuButton, navigation } = getMenuElements();
    const isMobile = mobileViewport.matches;
    menuButton.hidden = !isMobile;
    setExpanded(menuButton, navigation, false);
    navigation.hidden = isMobile;
  };

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) {
      return;
    }

    const { menuButton, navigation } = getMenuElements();

    if (event.target.closest(".menu-toggle")) {
      const isExpanded = menuButton.getAttribute("aria-expanded") === "true";
      setExpanded(menuButton, navigation, !isExpanded);
      return;
    }

    if (event.target.closest("#primary-navigation a")) {
      setExpanded(menuButton, navigation, false);
    }
  });

  document.addEventListener("keydown", (event) => {
    const { menuButton, navigation } = getMenuElements();

    if (
      event.key === "Escape" &&
      menuButton.getAttribute("aria-expanded") === "true"
    ) {
      setExpanded(menuButton, navigation, false);
      menuButton.focus();
    }
  });

  mobileViewport.addEventListener("change", syncViewport);
  document.addEventListener("astro:after-swap", () => {
    document.documentElement.classList.add("js");
  });
  document.addEventListener("astro:page-load", syncViewport);
  syncViewport();
</script>
