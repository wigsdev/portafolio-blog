---
interface Props {
  platform: string;
  url: string;
  iconSrc: string;
}

const { platform, url, iconSrc } = Astro.props;
---

<a
  class="group grid w-11 h-11 place-items-center rounded-full bg-surface-muted transition-colors hover:bg-brand focus-visible:bg-brand focus-visible:outline-2 focus-visible:outline-brand-dark"
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={platform}
>
  <img
    class="w-5.5 h-5.5 [html.dark_&]:brightness-0 [html.dark_&]:invert-[0.85] group-hover:brightness-0 group-hover:invert group-focus-visible:brightness-0 group-focus-visible:invert transition-all"
    src={iconSrc}
    alt=""
    width="22"
    height="22"
  />
</a>
