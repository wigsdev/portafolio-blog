---
interface Props {
  text: string;
  class?: string;
}

const { text, class: className } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center px-2 py-1 border border-text-muted rounded-full text-text-muted bg-surface text-xs font-semibold leading-none",
    className,
  ]}
>
  <span>{text}</span>
</span>
