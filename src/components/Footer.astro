---
import Social from "./Social.astro";
import ThemeToggle from "./ThemeToggle.astro";

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-content">
    <div class="social-links">
      <p class="social-label">Sígueme</p>
      <div class="social-icons">
        <Social
          platform="Facebook"
          url="https://web.facebook.com/wilmergulcochia/"
          iconSrc="/icons/social/facebook.svg"
        />
        <Social
          platform="Instagram"
          url="https://www.instagram.com/wigsdev/"
          iconSrc="/icons/social/instagram.svg"
        />
        <Social
          platform="GitHub"
          url="https://github.com/wigsdev"
          iconSrc="/icons/social/github.svg"
        />
        <Social
          platform="LinkedIn"
          url="https://www.linkedin.com/in/wigsdev/"
          iconSrc="/icons/social/linkedin.svg"
        />
      </div>
    </div>
    <div class="footer-bottom">
      <p class="copyright">Wilmer Gulcochía © {currentYear}</p>
      <ThemeToggle />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    margin-top: auto;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-background);
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 60rem;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 2rem);
  }

  @media (min-width: 90rem) {
    .footer-content {
      max-width: 72rem;
    }
  }

  .social-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .social-label {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .social-icons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  @media (max-width: 48rem) {
    .social-links {
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 1.5rem;
  }

  .footer-bottom p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
</style>
