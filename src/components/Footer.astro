---
import Social from "./Social.astro";
import ThemeToggle from "./ThemeToggle.astro";

const currentYear = new Date().getFullYear();
---

<footer class="w-full mt-auto border-t border-border bg-background">
  <div class="flex flex-col w-full max-w-4xl lg:max-w-6xl mx-auto px-4 md:px-8">
    <div class="flex items-center justify-center flex-wrap gap-4 py-6 border-b border-border max-md:flex-col max-md:gap-2">
      <p class="m-0 text-sm font-semibold tracking-wider uppercase text-text">
        Sígueme
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <Social
          platform="Facebook"
          url="https://web.facebook.com/wilmergulcochia/"
          iconSrc="/icons/social/facebook.svg"
        />
        <Social
          platform="Instagram"
          url="https://www.instagram.com/wigsdev/"
          iconSrc="/icons/social/instagram.svg"
        />
        <Social
          platform="GitHub"
          url="https://github.com/wigsdev"
          iconSrc="/icons/social/github.svg"
        />
        <Social
          platform="LinkedIn"
          url="https://www.linkedin.com/in/wigsdev/"
          iconSrc="/icons/social/linkedin.svg"
        />
      </div>
    </div>
    <div class="flex items-center justify-between flex-wrap gap-4 py-6">
      <p class="m-0 text-text-muted text-sm">
        Wilmer Gulcochía © {currentYear}
      </p>
      <ThemeToggle />
    </div>
  </div>
</footer>
