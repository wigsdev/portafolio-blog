---
---

<button
  type="button"
  class="group inline-flex items-center gap-1.5 py-1 px-1.5 border-none rounded bg-transparent text-text-muted text-sm font-medium cursor-pointer leading-none transition-colors duration-160 hover:text-brand focus-visible:outline-2 focus-visible:outline-brand focus-visible:outline-offset-3"
  id="theme-toggle"
  aria-label="Cambiar a modo oscuro"
>
  <span
    class="inline-flex items-center justify-center w-4.5 h-4.5"
    aria-hidden="true"
  >
    <span
      class="w-full h-full bg-current [mask:var(--icon)_no-repeat_center/contain] [-webkit-mask:var(--icon)_no-repeat_center/contain] block dark:hidden"
      style="--icon: url('/icons/ui/moon.svg')"
    ></span>
    <span
      class="w-full h-full bg-current [mask:var(--icon)_no-repeat_center/contain] [-webkit-mask:var(--icon)_no-repeat_center/contain] hidden dark:block"
      style="--icon: url('/icons/ui/sun.svg')"
    ></span>
  </span>
  <span class="theme-toggle-label text-inherit group-hover:text-brand">
    Oscuro
  </span>
</button>

<script is:inline>
  (() => {
    const updateThemeUI = () => {
      const button = document.getElementById("theme-toggle");
      if (!button) {
        return;
      }
      const isDark = document.documentElement.classList.contains("dark");
      const label = button.querySelector(".theme-toggle-label");
      if (label) {
        label.textContent = isDark ? "Claro" : "Oscuro";
      }
      button.setAttribute(
        "aria-label",
        isDark ? "Cambiar a modo claro" : "Cambiar a modo oscuro",
      );
    };

    if (!window.__themeToggleBound) {
      window.__themeToggleBound = true;

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) {
          return;
        }
        const button = target.closest("#theme-toggle");
        if (!button) {
          return;
        }

        event.preventDefault();
        const isDark = document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem("theme", isDark ? "dark" : "light");
        } catch (_) {}
        updateThemeUI();
      });

      document.addEventListener("astro:after-swap", updateThemeUI);
      document.addEventListener("astro:page-load", updateThemeUI);
    }

    updateThemeUI();
  })();
</script>
